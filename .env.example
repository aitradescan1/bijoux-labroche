# ============================================================
# LES PETITS BIJOUX — Variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs
# NE JAMAIS COMMITER .env.local sur GitHub !
# ============================================================

# --- Supabase ---
# Disponible dans : Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- PayPal ---
# Créer une app sur https://developer.paypal.com/dashboard/
# Utiliser "Sandbox" pour tester, "Live" pour la production
PAYPAL_CLIENT_ID=AYour_PayPal_Client_ID_Here
PAYPAL_CLIENT_SECRET=EYour_PayPal_Client_Secret_Here
# "sandbox" ou "live"
PAYPAL_MODE=sandbox

# --- Admin ---
# Mot de passe secret pour accéder à /admin.html et l'API admin
# Choisir une chaîne longue et aléatoire — ex: openssl rand -hex 32
ADMIN_SECRET=changez-moi-par-une-vraie-valeur-secrete

# --- Email (Nodemailer via Gmail) ---
# Utiliser un "App Password" Gmail (pas le vrai mot de passe)
# https://myaccount.google.com/apppasswords
EMAIL_USER=votre.email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_DESTINATAIRE=adulte.responsable@gmail.com

# --- POS (Point de vente en boutique) ---
# PIN à 4-6 chiffres que Nathan & Lyam tapent sur le téléphone pour confirmer une vente
# Exemple : POS_PIN=1234  (choisir un vrai code secret !)
POS_PIN=changez-moi

# --- CORS ---
# URL du frontend GitHub Pages (sans slash final)
ALLOWED_ORIGIN=https://GITHUB_USER.github.io
